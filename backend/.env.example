# ============================================
# Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000

# MongoDB Connection String
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/credential-system
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/credential-system

# JWT Secret for authentication (change this to a random string)
JWT_SECRET=your-secret-key-here

# Blockchain Configuration
# For local Hardhat node:
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# For Sepolia testnet (via Alchemy):
# BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private Key of the deployer/issuer wallet
# ⚠️ NEVER commit your real private key to version control!
# For Hardhat local node, use one of the default accounts:
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed Smart Contract Address
# This will be filled in after running: npx hardhat run scripts/deploy.js --network localhost
CONTRACT_ADDRESS=

# Sepolia Testnet Configuration (optional)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Pinata IPFS Configuration
# Get your keys from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_token
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET=your_pinata_secret_key
